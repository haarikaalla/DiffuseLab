# ============================================================
#  AI Image Studio — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# --- HuggingFace (FREE — get token at huggingface.co/settings/tokens) ---
HF_API_TOKEN=hf_your_token_here

# --- Models (these are FREE public models on HuggingFace) ---
# Primary model: Stable Diffusion XL
SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Faster/lighter model for quick previews
SD_FAST_MODEL=stabilityai/stable-diffusion-2-1

# --- App settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Storage ---
GALLERY_DIR=static/gallery
DATABASE_URL=sqlite+aiosqlite:///./studio.db

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT=20
